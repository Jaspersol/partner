{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The shell hosts the UI and spawns the API; the webview needs no Tauri commands of its own.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging"
  ]
}
