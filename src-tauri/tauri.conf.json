{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Partner",
  "version": "0.1.0",
  "identifier": "dev.partner.shell",
  "build": {
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../ui run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' http://asset.localhost 'wasm-unsafe-eval'; connect-src http://127.0.0.1:* http://asset.localhost ipc: http://ipc.localhost; img-src 'self' data: blob: http://asset.localhost; media-src 'self' blob: http://asset.localhost; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$LOCALDATA/Partner/pet/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../src/Partner.Api/bin/Release/net10.0/win-x64/publish": "api/",
      "../engines/tts/tts-server.py": "engines/tts/tts-server.py",
      "../engines/kws-asr/asr-server.py": "engines/kws-asr/asr-server.py",
      "../THIRD-PARTY-NOTICES.md": "notices/THIRD-PARTY-NOTICES.md",
      "../third-party/MIT-easy-live2d.txt": "notices/licenses/MIT-easy-live2d.txt",
      "../third-party/MIT-pixi.js.txt": "notices/licenses/MIT-pixi.js.txt",
      "../third-party/MIT-pixi-sound.txt": "notices/licenses/MIT-pixi-sound.txt",
      "../third-party/Live2D-Open-Software-License.txt": "notices/licenses/Live2D-Open-Software-License.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./nsis/hooks.nsh"
      }
    }
  }
}
