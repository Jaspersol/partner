<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- UI data layer (M14): the four views bind to this. Kestrel + Minimal API, no extra packages. -->
    <!-- Windows-only on purpose: the queue has a single in-process consumer and no cross-process lock, so the
       voice halves must live in this same process. Partner.Voice is net8.0-windows, which settles it. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Partner.Api</RootNamespace>
    <AssemblyName>partner-api</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Partner.Core/Partner.Core.csproj" />
    <ProjectReference Include="../Partner.Desktop/Partner.Desktop.csproj" />
    <ProjectReference Include="../Partner.Voice/Partner.Voice.csproj" />
  </ItemGroup>
</Project>
