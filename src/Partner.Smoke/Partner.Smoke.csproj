    <ProjectReference Include="../Partner.Voice/Partner.Voice.csproj" />
    <ProjectReference Include="../Partner.Game/Partner.Game.csproj" />
    <ProjectReference Include="../Partner.Api/Partner.Api.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
