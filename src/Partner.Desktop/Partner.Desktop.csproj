<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Windows-only layer (M9). Core stays platform-neutral on net10.0. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <!-- UI Automation ships in the WindowsDesktop pack (WPF). Without it the only way to address a control is
         a screen coordinate, which is how a model ends up typing into the wrong window. -->
    <UseWPF>true</UseWPF>
    <RootNamespace>Partner.Desktop</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Partner.Core/Partner.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The INPUT records are the contract: the flags and the normalized coordinates are what was silently
         wrong before, and a test has to be able to read them without moving the user's mouse. -->
    <InternalsVisibleTo Include="Partner.Desktop.Tests" />
    <!-- The smoke asserts the same contract in the capability gate, and it must not move the pointer either. -->
    <InternalsVisibleTo Include="partner-smoke" />
  </ItemGroup>
</Project>
