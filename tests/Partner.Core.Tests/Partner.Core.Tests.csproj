<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Partner.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Partner.Core/Partner.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      The archived responses the engine parsers are tested against. Copied into a flat folder in the output, so a
      test names one file and nothing else, and so they travel with the assembly rather than with an assumption
      about where the test runs from.
    -->
    <None Update="Agent\Web\Engines\Fixtures\**\*" Link="web-fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
