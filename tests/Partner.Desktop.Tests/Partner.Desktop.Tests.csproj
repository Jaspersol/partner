<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Partner.Desktop.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- The live UIA test hosts a real window with a real button on an STA thread; without WinForms there is
         no way to prove that a named control is actually pressed through its pattern. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Partner.Desktop/Partner.Desktop.csproj" />
  </ItemGroup>
</Project>
